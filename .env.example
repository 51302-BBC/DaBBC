# Use letters and numbers for this PostgreSQL password so it is URL-safe.
POSTGRES_PASSWORD=
BOOTSTRAP_OWNER_EMAIL=owner@example.test
BOOTSTRAP_OWNER_PASSWORD=
APP_BASE_URL=http://localhost:8080
WEB_BIND=127.0.0.1:8080
COOKIE_SECURE=false
# Mailpit is available with docker compose --profile demo up --build.
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_FROM=accounting@example.test
# Optional demonstration policy. Confirm the office decision before using it with employee data.
ADMIN_REVIEW_ROUTING=shared
REPORT_FINALIZER_ROLE=admin
# Set owner, creator, or assignee only after deciding who may make these changes.
TASK_CANCEL_POLICY=
TASK_REOPEN_POLICY=
